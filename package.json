{
  "name": "nudge-reach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:rls": "npx esbuild scripts/enable-rls.ts --bundle --platform=node --format=cjs --outfile=.next/enable-rls.cjs --external:@prisma/client && node .next/enable-rls.cjs",
    "eval:agent": "npx esbuild scripts/agent-eval.ts --bundle --platform=node --format=cjs --outfile=.next/agent-eval.cjs --external:@prisma/client --external:@anthropic-ai/sdk && node .next/agent-eval.cjs",
    "db:studio": "prisma studio",
    "preflight:live": "npx esbuild scripts/preflight-live.ts --bundle --platform=node --format=cjs --outfile=.next/preflight-live.cjs && node .next/preflight-live.cjs",
    "backfill:multi-number": "npx esbuild scripts/backfill-multi-number.ts --bundle --platform=node --format=cjs --outfile=.next/backfill-multi-number.cjs --external:@prisma/client && node .next/backfill-multi-number.cjs",
    "plan:set": "npx esbuild scripts/set-plan.ts --bundle --platform=node --format=cjs --outfile=.next/set-plan.cjs --external:@prisma/client && node .next/set-plan.cjs",
    "postinstall": "prisma generate",
    "voice:minutes": "npx esbuild scripts/set-voice-minutes.ts --bundle --platform=node --format=cjs --outfile=.next/set-voice-minutes.cjs --external:@prisma/client && node .next/set-voice-minutes.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@google/genai": "^2.21.0",
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.22.0",
    "motion": "^12.42.0",
    "next": "16.2.9",
    "openai": "^7.10.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
