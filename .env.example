# ============================================================
# Nudge Reach — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ============================================================

# --- Supabase (Dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# Use the new "publishable" key (replaces the legacy anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Database (Dashboard → Project Settings → Database) ---
# Pooled connection (pgbouncer, port 6543) — used by the app at runtime
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used by Prisma for migrations/db push
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Runtime AI (Phase 1+) ---
# The deployed app only ever calls the cheap vision-capable Haiku tier.
ANTHROPIC_API_KEY=""
RUNTIME_MODEL="claude-sonnet-5"   # production choice; "claude-haiku-4-5" is the cheaper fallback. Opus/Fable are blocked by the guard.

# --- Messaging mode ---
# "simulation" = full flow with mocked Meta responses (no WhatsApp account needed)
# "live"       = real WhatsApp Cloud API (requires all WHATSAPP_* vars below)
SEND_MODE="simulation"

# --- WhatsApp Cloud API (Phase 3+, only needed when SEND_MODE=live) ---
WHATSAPP_API_VERSION="v23.0"
WABA_ID=""
PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Random string you choose; Meta echoes it back when verifying the webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Meta app secret, used to verify X-Hub-Signature-256 on webhooks
META_APP_SECRET=""

# --- Security ---
# 32+ char random string used to encrypt WhatsApp access tokens at rest
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# --- Cost transparency (configurable; verify against Meta's pricing page) ---
# Estimated price per delivered marketing message in INR
WHATSAPP_MARKETING_RATE_INR="0.99"

# --- Payments — Razorpay (optional) ---
# Leave empty to run billing in free mode ("add keys to enable payments").
# Dashboard → Settings → API Keys. The webhook secret is set when you create
# a webhook in Razorpay pointing at /api/webhooks/razorpay.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Payments — Stripe (optional; USD orgs / global markets) ---
# Dashboard → Developers → API keys. The webhook secret comes from creating a
# webhook endpoint pointing at /api/webhooks/stripe (checkout.session.completed).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Transactional email — Resend (optional) ---
# Leave empty and team invites still work (invitees auto-join on signup);
# with a key, invitees also get a real invite email.
RESEND_API_KEY=""
# Verified sender, e.g. "Nudge <team@yourdomain.com>"
EMAIL_FROM=""

# --- "Get Access" lead forwarding (optional) ---
# Apps Script web-app URL that appends each lead to the founders' Google Sheet.
# Leave empty and leads still land in the AccessRequest table.
LEADS_SHEET_WEBHOOK_URL=""

# --- Google Calendar (optional; AI Front Desk booking + reminders) ---
# Leave empty and "Connect calendar" works in SIMULATION with a mocked calendar
# (no Google app needed). Fill these only for SEND_MODE=live real OAuth.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match a redirect URI on the OAuth client, e.g.
# https://your-app.com/api/integrations/google/callback
GOOGLE_OAUTH_REDIRECT_URI=""

# --- Google Places (optional) ---
# Powers the Google Business Profile knowledge import. Leave empty and the
# import runs in SIMULATION with a demo profile (keyless demo works).
# Google Cloud Console -> enable "Places API (New)" -> API key.
GOOGLE_MAPS_API_KEY=""

# --- Public app origin (optional) ---
# Used for links in emails; falls back to the deployed URL.
NEXT_PUBLIC_APP_URL=""

# Show "Sign in with Google" on /login. Set to 1 ONLY after enabling the Google
# provider in Supabase → Authentication → Providers (otherwise the button errors).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=""

# --- Cron protection (optional, recommended in production) ---
# When set, /api/cron/* requires "Authorization: Bearer <CRON_SECRET>".
# Vercel sends this header automatically when the env var exists.
CRON_SECRET=""

# Voice front desk (optional — leave empty to keep the simulation voice driver)
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""            # printed by scripts/voice-setup.ts
ELEVENLABS_WEBHOOK_SECRET=""      # post-call webhook HMAC secret from the ElevenLabs dashboard
ELEVENLABS_LLM="claude-haiku-4-5" # model ElevenLabs runs on calls; Opus/Fable rejected by the guard
VOICE_INITIATION_SECRET=""        # header secret ElevenLabs sends to /api/voice/initiation
VOICE_TOOLS_SECRET=""             # bearer secret for /api/voice/tools/*
