generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// One org per user for MVP (PRD §3). ownerUserId is the Supabase Auth user id.
model Org {
  id          String     @id @default(cuid())
  name        String
  ownerUserId String     @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  contacts    Contact[]
  audiences   Audience[]
  products    Product[]
  campaigns   Campaign[]
  whatsappAccounts WhatsappAccount[]
}

model WhatsappAccount {
  id                   String   @id @default(cuid())
  orgId                String   @unique // one connected number per org (MVP)
  org                  Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  wabaId               String
  phoneNumberId        String
  displayName          String
  accessTokenEncrypted String
  qualityRating        String?
  status               String   @default("connected")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
}

model Template {
  id              String         @id @default(cuid())
  campaignId      String
  campaign        Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name            String
  language        String         @default("en")
  category        String         @default("MARKETING")
  componentsJson  Json
  metaTemplateId  String?
  metaStatus      TemplateStatus @default(PENDING)
  rejectionReason String?
  submittedAt     DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([campaignId])
}

model Product {
  id         String     @id @default(cuid())
  orgId      String
  org        Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  photoUrl   String?
  attributes Json?
  createdAt  DateTime   @default(now())
  campaigns  Campaign[]

  @@index([orgId])
}

enum CampaignStatus {
  DRAFT
  TEMPLATE_PENDING
  TEMPLATE_APPROVED
  SENDING
  SENT
  FAILED
}

model Campaign {
  id        String         @id @default(cuid())
  orgId     String
  org       Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  status    CampaignStatus @default(DRAFT)
  // The editable campaign fields in the PRD §7 JSON shape (header, body,
  // footer, buttons, sampleName, …). Meta template rows come in Phase 3.
  content    Json
  audienceId String?
  audience   Audience?      @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  templates  Template[]
  messages   Message[]

  @@index([orgId])
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  CLICKED
  FAILED
}

model Message {
  id             String        @id @default(cuid())
  campaignId     String
  campaign       Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status         MessageStatus @default(QUEUED)
  metaMessageId  String?
  errorCode      String?
  costMinorUnits Int?
  sentAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([campaignId, contactId]) // a contact gets a campaign at most once
  @@index([campaignId])
  @@index([metaMessageId])
}

// Raw webhook payloads stored before processing — idempotency + audit.
model WebhookEvent {
  id          String    @id @default(cuid())
  raw         Json
  type        String
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

// Consent is data, not UI: optedIn + optedOutAt drive the consent gate
// (lib/consent.ts). optedOutAt set means permanently excluded from marketing.
model Contact {
  id          String            @id @default(cuid())
  orgId       String
  org         Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  phoneE164   String
  optedIn     Boolean           @default(false)
  optInSource String            @default("manual")
  optedOutAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  audiences   AudienceContact[]
  messages    Message[]

  @@unique([orgId, phoneE164])
  @@index([orgId])
}

model Audience {
  id        String            @id @default(cuid())
  orgId     String
  org       Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime          @default(now())
  contacts  AudienceContact[]
  campaigns Campaign[]

  @@index([orgId])
}

model AudienceContact {
  audienceId String
  audience   Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([audienceId, contactId])
}
