generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Team roles (spec §3.1): OWNER = everything, ADMIN = everything but
// billing/org-delete, AGENT = inbox + contacts read/write only.
enum OrgRole {
  OWNER
  ADMIN
  AGENT
}

// Simple CRM pipeline stage for a contact (spec §3.2).
enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

// One org per user for MVP (PRD §3). ownerUserId is the Supabase Auth user id.
// Teams arrive via Membership rows; ownerUserId stays the canonical owner.
model Org {
  id          String     @id @default(cuid())
  name        String
  ownerUserId String     @unique
  // Business vertical picked during onboarding (e.g. "boutique", "restaurant").
  vertical    String?
  // Set when the onboarding wizard completes (or is skipped).
  onboardedAt DateTime?
  // Per-org test mode: sends, approvals, calendar and payments stay mocked
  // until a real WhatsApp number is connected. SEND_MODE=simulation still
  // mocks everything globally (invariant #4); this only matters in live.
  simulated   Boolean    @default(true)
  // AI Front Desk trial for self-serve signups; cleared when a subscription
  // activates, expired to Free by the cron tick.
  trialEndsAt DateTime?
  // Free-form org preferences, e.g. { "avgOrderValueInr": 1499 }.
  settings    Json       @default("{}")
  // Globalization (spec: global outreach). Defaults preserve the original
  // India-first behavior for existing rows.
  currency    String     @default("INR") // "INR" | "USD"
  dialCode    String     @default("+91") // default country code for bare phone numbers
  timezone    String     @default("Asia/Kolkata")
  // Billing (spec: real usage + Razorpay when keys present). plan defaults to
  // the free tier; the paid fields fill in after a successful subscription.
  plan                   String    @default("free") // free | starter | growth | pro
  subscriptionStatus     String    @default("inactive") // inactive | active | past_due | cancelled
  razorpayCustomerId     String?
  razorpaySubscriptionId String?
  currentPeriodEnd       DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  contacts    Contact[]
  audiences   Audience[]
  products    Product[]
  campaigns   Campaign[]
  whatsappAccounts WhatsappAccount[]
  agentProfile     AgentProfile?
  conversations    Conversation[]
  memberships      Membership[]
  invites          Invite[]
  tags             Tag[]
  notes            Note[]
  automations      Automation[]
  automationRuns   AutomationRun[]
  apiKeys          ApiKey[]
  templates        Template[]
  webhookEndpoints WebhookEndpoint[]
  auditLogs        AuditLog[]
  bookingRequests  BookingRequest[]
  paymentRequests  PaymentRequest[]
  calendarAccount  CalendarAccount?
  followUpConfig   FollowUpConfig?
  knowledgeEntries KnowledgeEntry[]
  ownerQuestions   OwnerQuestion[]
}

// An outbound webhook subscription (spec §M8 integrations): the app POSTs
// signed JSON to `url` when subscribed events fire. Consumed by Zapier/Make/
// n8n/custom endpoints. Secret signs the payload (HMAC-SHA256).
model WebhookEndpoint {
  id           String   @id @default(cuid())
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  url          String
  secret       String
  // Subscribed event names, e.g. ["message.received","campaign.completed"].
  events       String[]
  enabled      Boolean  @default(true)
  lastStatus   Int?
  lastDeliveryAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deliveries   WebhookDelivery[]

  @@index([orgId])
}

// Delivery attempt log for a webhook endpoint (audit + debugging in the UI).
model WebhookDelivery {
  id         String          @id @default(cuid())
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event      String
  status     Int?            // HTTP status, null if the request never completed
  ok         Boolean         @default(false)
  error      String?
  createdAt  DateTime        @default(now())

  @@index([endpointId, createdAt])
}

// Audit trail for sensitive actions (role changes, opt-outs, key/webhook
// management, campaign runs, connection changes). Append-only; viewer at
// Settings → Audit log (admin+). actorName denormalized so rows survive
// member removal.
model AuditLog {
  id          String   @id @default(cuid())
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorUserId String
  actorName   String
  action      String // e.g. "member.role_changed", "contact.opted_out"
  target      String? // human-readable subject, e.g. "Priya Sharma (+91…)"
  detail      String? // short free-text context
  createdAt   DateTime @default(now())

  @@index([orgId, createdAt])
}

// A user's seat in an org. userId is the Supabase Auth user id (fictional
// "demo-agent-*" ids are allowed for seeded teammates used in assignment
// dropdowns). The org owner gets an OWNER membership backfilled lazily.
model Membership {
  id                String   @id @default(cuid())
  orgId             String
  org               Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId            String
  email             String
  displayName       String?
  role              OrgRole  @default(AGENT)
  // Per-member notification toggles (Settings → Notifications).
  notificationPrefs Json     @default("{}")
  createdAt         DateTime @default(now())

  @@unique([orgId, userId])
  @@index([userId])
}

// Email invite to join an org. status: "pending" | "accepted". No invite
// emails in the MVP — a matching signup auto-accepts (lib/org.ts).
model Invite {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email     String
  role      OrgRole  @default(AGENT)
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@unique([orgId, email])
}

// Org-scoped label applied to contacts and conversations. color is a badge
// tone name (emerald, amber, sky, …), not a hex value.
model Tag {
  id            String            @id @default(cuid())
  orgId         String
  org           Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  color         String            @default("emerald")
  createdAt     DateTime          @default(now())
  contacts      ContactTag[]
  conversations ConversationTag[]

  @@unique([orgId, name])
}

model ContactTag {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}

model ConversationTag {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tagId          String
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@index([tagId])
}

// Internal note left by a teammate on a contact and/or a conversation.
// Never sent to the customer. authorName is denormalized for display.
model Note {
  id             String        @id @default(cuid())
  orgId          String
  org            Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorUserId   String
  authorName     String
  body           String
  createdAt      DateTime      @default(now())

  @@index([orgId])
  @@index([contactId])
  @@index([conversationId])
}

// A trigger + ordered steps workflow (spec §3.2). trigger is one of:
// message_received | keyword | contact_created | tag_added | campaign_reply.
// triggerConfig holds trigger-specific settings (e.g. { keywords, match }).
model Automation {
  id            String           @id @default(cuid())
  orgId         String
  org           Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  description   String           @default("")
  enabled       Boolean          @default(false)
  trigger       String
  triggerConfig Json             @default("{}")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  steps         AutomationStep[]
  runs          AutomationRun[]

  @@index([orgId])
}

// One step in an automation. kind is one of: send_message | send_template |
// add_tag | assign_agent | update_lead_stage | wait | resolve_conversation |
// handoff_to_human. config holds kind-specific settings.
model AutomationStep {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  order        Int
  kind         String
  config       Json       @default("{}")

  @@unique([automationId, order])
}

enum AutomationRunStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
}

// One execution of an automation against a contact/conversation. `wait`
// steps park the run (status WAITING + resumeAt) until the cron tick resumes
// it. log is an append-only array of per-step result entries.
model AutomationRun {
  id             String              @id @default(cuid())
  automationId   String
  automation     Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  orgId          String
  org            Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contactId      String?
  conversationId String?
  status         AutomationRunStatus @default(RUNNING)
  currentStep    Int                 @default(0)
  resumeAt       DateTime?
  log            Json                @default("[]")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([orgId])
  @@index([automationId])
  @@index([status, resumeAt])
}

// Programmatic API access. Only the sha256 hash is stored; the full key is
// shown once at creation. prefix (e.g. "nk_live") is kept for display.
model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  org        Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([orgId])
}

// Per-tenant AI auto-reply agent config (Phase 7). NOT model training — the
// "training" is this profile (vertical template + business knowledge + tone +
// guardrails). Scoped to one business, per Meta's 2026 AI policy.
model AgentProfile {
  id           String   @id @default(cuid())
  orgId        String   @unique
  org          Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  enabled      Boolean  @default(false)
  vertical     String   @default("restaurant")
  businessName String
  // Owner-provided knowledge: hours, address, menu highlights, booking policy.
  businessInfo String   @default("")
  tone         String   @default("Warm, friendly, and concise")
  doNots       String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A two-way thread with one contact. lastInboundAt drives the WhatsApp 24-hour
// customer-service window (free-form replies allowed only within it).
// status ∈ open | pending | resolved | handoff (legacy "closed" rows are
// treated as "resolved" in queries; "handoff" shows under Open w/ a badge).
model Conversation {
  id                 String                @id @default(cuid())
  orgId              String
  org                Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contactId          String
  contact            Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lastInboundAt      DateTime?
  status             String                @default("open") // open | pending | resolved | handoff (legacy: closed)
  // Membership.userId of the assigned agent (null = unassigned).
  assignedToUserId   String?
  // Unread inbound messages; zeroed when the thread is opened in the inbox.
  unreadCount        Int                   @default(0)
  // Denormalized for the inbox list — updated on every send/receive.
  lastMessageAt      DateTime?
  lastMessagePreview String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  messages           ConversationMessage[]
  tags               ConversationTag[]
  notes              Note[]

  @@unique([orgId, contactId])
  @@index([orgId])
  // Inbox list: newest-first within an org.
  @@index([orgId, lastMessageAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String       // "inbound" | "outbound"
  body           String
  metaMessageId  String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model WhatsappAccount {
  id                   String   @id @default(cuid())
  orgId                String   @unique // one connected number per org (MVP)
  org                  Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  wabaId               String
  phoneNumberId        String
  displayName          String
  accessTokenEncrypted String
  qualityRating        String?
  status               String   @default("connected")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

// A WhatsApp message template. Two flavors share this table:
// - campaign templates (campaignId set) — generated per campaign, as before;
// - library templates (orgId set, campaignId null) — reusable, managed at
//   /templates. content holds the editable §7-shape source; componentsJson
//   stays the Meta create payload.
model Template {
  id              String         @id @default(cuid())
  campaignId      String?
  campaign        Campaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  orgId           String?
  org             Org?           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  language        String         @default("en")
  category        String         @default("MARKETING")
  // Editable source in the PRD §7 campaign-content shape (library templates).
  content         Json?
  componentsJson  Json
  metaTemplateId  String?
  metaStatus      TemplateStatus @default(PENDING)
  rejectionReason String?
  submittedAt     DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([campaignId])
  @@index([orgId])
}

model Product {
  id         String     @id @default(cuid())
  orgId      String
  org        Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  photoUrl   String?
  attributes Json?
  createdAt  DateTime   @default(now())
  campaigns  Campaign[]

  @@index([orgId])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  TEMPLATE_PENDING
  TEMPLATE_APPROVED
  SENDING
  SENT
  FAILED
}

model Campaign {
  id        String         @id @default(cuid())
  orgId     String
  org       Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  status    CampaignStatus @default(DRAFT)
  // The editable campaign fields in the PRD §7 JSON shape (header, body,
  // footer, buttons, sampleName, …). Meta template rows come in Phase 3.
  content    Json
  audienceId String?
  audience   Audience?      @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  // When status is SCHEDULED, the cron tick enqueues the campaign once
  // scheduledAt is due (spec §M4).
  scheduledAt DateTime?
  // Library Template id this campaign was created from, if any (display only).
  sourceTemplateId String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  templates  Template[]
  messages   Message[]

  @@index([orgId])
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  CLICKED
  FAILED
}

model Message {
  id             String        @id @default(cuid())
  campaignId     String
  campaign       Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status         MessageStatus @default(QUEUED)
  metaMessageId  String?
  errorCode      String?
  costMinorUnits Int?
  sentAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([campaignId, contactId]) // a contact gets a campaign at most once
  @@index([campaignId])
  @@index([metaMessageId])
}

// Raw webhook payloads stored before processing — idempotency + audit.
model WebhookEvent {
  id          String    @id @default(cuid())
  raw         Json
  type        String
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

// Consent is data, not UI: optedIn + optedOutAt drive the consent gate
// (lib/consent.ts). optedOutAt set means permanently excluded from marketing.
model Contact {
  id          String            @id @default(cuid())
  orgId       String
  org         Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  phoneE164   String
  email       String?
  optedIn     Boolean           @default(false)
  optInSource String            @default("manual")
  optedOutAt  DateTime?
  // CRM pipeline stage (spec §3.2).
  leadStage   LeadStage         @default(NEW)
  // Membership.userId of the assigned agent (null = unassigned).
  assignedToUserId String?
  // Last time the org messaged this contact (any channel/path).
  lastContactedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  audiences   AudienceContact[]
  messages    Message[]
  conversations Conversation[]
  tags        ContactTag[]
  notes       Note[]
  bookingRequests BookingRequest[]
  paymentRequests PaymentRequest[]

  @@unique([orgId, phoneE164])
  @@index([orgId])
  // Contacts list: newest-first within an org.
  @@index([orgId, createdAt])
}

// A booking/appointment request the AI agent captured from a conversation
// (Milestone 1 "worker" action). It records intent for staff to confirm — it
// does NOT hit an external calendar yet (that's a later per-vertical tool), so
// it is deliberately low-risk and reversible.
model BookingRequest {
  id             String   @id @default(cuid())
  orgId          String
  org            Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId String?
  // Free-text as the customer stated it (e.g. "tomorrow 8pm"), plus a parsed
  // party size when given. We keep the raw text so staff see exactly what was asked.
  name           String
  requestedFor   String
  partySize      Int?
  notes          String?
  status         String   @default("pending") // pending | confirmed | declined | no_show | completed
  // Parsed appointment instant (when we could resolve one) — powers the T-24h/
  // T-2h reminders and no-show detection. Null when only free text is known.
  scheduledFor   DateTime?
  // Real calendar event id when the agent booked into a connected calendar.
  calendarEventId String?
  // Revenue-Recovery follow-up idempotency stamps (5.2): set once each fires.
  reminder24SentAt DateTime?
  reminder2SentAt  DateTime?
  reviewAskedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orgId, status])
  @@index([contactId])
  @@index([scheduledFor])
}

// A customer-facing payment link the agent (or staff) sent in a conversation —
// booking deposits, advances, bills. Separate from subscription billing (the
// org paying US); this is the org's customer paying THEM. Provider "simulation"
// rows demo end-to-end with zero keys (invariant #4).
model PaymentRequest {
  id             String   @id @default(cuid())
  orgId          String
  org            Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId String?
  // Optional link back to the booking this deposit secures.
  bookingRequestId String?
  // Minor units (paise for INR). Currency follows the org's currency.
  amountMinor    Int
  currency       String   @default("INR")
  purpose        String
  status         String   @default("created") // created | paid | cancelled | expired
  provider       String // razorpay | simulation
  providerLinkId String? // Razorpay payment-link id (plink_…)
  shortUrl       String
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orgId, status])
  @@index([contactId])
  @@index([providerLinkId])
}

// Per-org Revenue-Recovery follow-up config (5.2). One toggle turns the whole
// pack on; the individual recipe flags let a founder trim it later.
model FollowUpConfig {
  id                String   @id @default(cuid())
  orgId             String   @unique
  org               Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  enabled           Boolean  @default(false)
  bookingReminders  Boolean  @default(true)
  noShowRebook      Boolean  @default(true)
  postServiceReview Boolean  @default(true)
  leadNudge         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Per-org connected booking calendar (Google). One per org (MVP), mirroring
// WhatsappAccount. In simulation the row is written with simulated=true and a
// "sim" sentinel token so the whole booking flow demos with zero Google setup.
model CalendarAccount {
  id                    String   @id @default(cuid())
  orgId                 String   @unique
  org                   Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider              String   @default("google")
  accountEmail          String
  calendarId            String   @default("primary")
  // Encrypted OAuth refresh token (live). Holds the literal "sim" when simulated.
  refreshTokenEncrypted String
  simulated             Boolean  @default(false)
  status                String   @default("connected")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Audience {
  id        String            @id @default(cuid())
  orgId     String
  org       Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime          @default(now())
  contacts  AudienceContact[]
  campaigns Campaign[]

  @@index([orgId])
}

model AudienceContact {
  audienceId String
  audience   Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([audienceId, contactId])
}

// Public waitlist signups from the marketing landing page (/waitlist).
// Not org-scoped — these are pre-signup leads. Inserts happen server-side via
// Prisma (table owner); enable RLS with no policies in Supabase so the
// publishable key can't read/write it directly (consistent with other tables).
model WaitlistSignup {
  id        String   @id @default(cuid())
  shopName  String
  city      String
  phoneE164 String
  vertical  String
  source    String   @default("landing")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// "Get Access" popup on the marketing hero. Stored first (leads survive even
// with email unconfigured), then forwarded to the founders' inbox via Resend.
model AccessRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phoneE164 String
  source    String   @default("hero")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Structured agent knowledge — one fact per row (spec 2026-07-10). The agent
// reads a categorized digest of active rows, never the raw table. `condition`
// is a plain-language applicability window ("weekends only") applied against
// the org-local current time in the prompt.
model KnowledgeEntry {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category  String   // menu_services | pricing | hours | location | policies | payments | faq | other
  fact      String
  condition String?  // plain-language applicability, e.g. "weekends only"
  source    String   // owner_answer | questionnaire | manual | import
  status    String   @default("active") // active | draft (imported, awaiting review) | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status, category])
}

// A question the agent could not answer, waiting for the owner
// (learn-on-the-job). Deduped in code on (orgId, questionKey, pending) —
// ten customers asking the same thing become one owner question, and every
// waiter in `waiting` gets a follow-up when the answer arrives (24h-gated).
model OwnerQuestion {
  id          String    @id @default(cuid())
  orgId       String
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  question    String
  questionKey String
  status      String    @default("pending") // pending | answered | dismissed
  waiting     Json      @default("[]") // [{conversationId, contactId, askedAt, followedUpAt?}]
  askCount    Int       @default(1)
  answerText  String?
  entryIds    String[]  @default([])
  askedAt     DateTime  @default(now())
  answeredAt  DateTime?

  @@index([orgId, status])
  @@index([orgId, questionKey])
}
